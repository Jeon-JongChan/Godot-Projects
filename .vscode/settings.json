{
    "godotTools.editorPath.godot4": "c:\\Users\\user\\Documents\\projects\\Godot-Projects\\Godot_v4.6.3-stable_win64_console.exe",
    
    // Antigravity 에이전트가 파일 생성/수정 시 자동으로 에디터 탭을 여는 현상 방지
